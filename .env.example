MAC_PNG_URL= # URL of the TraCAD Python Application service
API_KEY_1=
API_KEY_2=
JWT_SECRET=
CORS_ORIGINS=
NODE_ENV=

# Cloud storage config
PROJECT_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
STORAGE_MEDIA_BUCKET=
